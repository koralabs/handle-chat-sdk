{
  "name": "@koralabs/handle-chat-sdk",
  "version": "1.0.0",
  "description": "Programmatic client for handle-to-handle E2E chat (chat.handle.me): wallet-rooted identities (sign-to-derive), libsignal WASM sessions, transports, invite links, and the SSR guardian payloads.",
  "type": "module",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "examples": "node examples/quickstart.mjs && node examples/guardian-flow.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/circuit-relay-v2": "^4.2.7",
    "@libp2p/identify": "^4.1.8",
    "@libp2p/interface": "^3.2.4",
    "@libp2p/webrtc": "^6.0.25",
    "@libp2p/websockets": "^10.1.15",
    "@multiformats/multiaddr": "^13.0.3",
    "libp2p": "^3.3.4",
    "qrcode-generator": "^1.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode-generator": "^0.0.16",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "messaging",
    "encryption",
    "handles",
    "chat",
    "sdk",
    "libsignal",
    "cardano"
  ],
  "author": "",
  "license": "AGPL-3.0-only"
}
